{"case_id": "dev-007", "split": "dev", "review_status": "draft", "tags": ["sound-alike", "urticaria"], "transcript": [{"id": "u01", "speaker": "doctor", "text": "Hello, please tell me your name and age."}, {"id": "u02", "speaker": "patient", "text": "Meena Iyer, 35."}, {"id": "u03", "speaker": "patient", "text": "I have itchy red rashes on my arms and back since this morning. They come and go."}, {"id": "u04", "speaker": "doctor", "text": "Did you eat anything new, or take any new medicine?"}, {"id": "u05", "speaker": "patient", "text": "I ate prawns last night for the first time."}, {"id": "u06", "speaker": "doctor", "text": "Any swelling of the lips or difficulty breathing?"}, {"id": "u07", "speaker": "patient", "text": "No."}, {"id": "u08", "speaker": "doctor", "text": "I see raised red wheals on the arms and back. No lip swelling. Chest is clear."}, {"id": "u09", "speaker": "doctor", "text": "This is acute urticaria, likely an allergy to the prawns."}, {"id": "u10", "speaker": "doctor", "text": "I am giving you hydroxyzine 25 mg, one tablet at night for five days. It will help the itching."}, {"id": "u11", "speaker": "patient", "text": "Hydralazine? My father takes hydralazine for his BP."}, {"id": "u12", "speaker": "doctor", "text": "No, not hydralazine. Hydroxyzine, H Y D R O X Y Z I N E. It is an anti-allergy medicine."}, {"id": "u13", "speaker": "doctor", "text": "Avoid prawns and other shellfish. Do not drive after taking it, it can make you sleepy."}, {"id": "u14", "speaker": "doctor", "text": "If you get swelling of the lips or breathing trouble, go to the emergency department immediately."}], "expected_prescription": {"patient_details": {"name": {"value": "Meena Iyer", "evidence": ["u02"], "flag": null}, "age": {"value": 35, "evidence": ["u02"], "flag": null}}, "chief_complaints": [{"value": "Itchy red rash on arms and back", "evidence": ["u03"], "flag": null}], "history_of_present_illness": {"value": "Itchy red rashes on arms and back since this morning that come and go, after eating prawns for the first time last night, no lip swelling or breathing difficulty", "evidence": ["u03", "u05", "u07"], "flag": null}, "duration": {"value": "Since this morning", "evidence": ["u03"], "flag": null}, "allergies": [{"value": "Prawns (suspected)", "evidence": ["u05", "u09"], "flag": null}], "examination_findings": [{"value": "Raised red wheals on arms and back", "evidence": ["u08"], "flag": null}, {"value": "No lip swelling", "evidence": ["u08"], "flag": null}, {"value": "Chest clear", "evidence": ["u08"], "flag": null}], "diagnosis": [{"value": "Acute urticaria, likely prawn allergy", "evidence": ["u09"], "flag": null}], "medications": [{"medicine_name": {"value": "Hydroxyzine", "evidence": ["u10", "u12"], "flag": null}, "strength": {"value": "25 mg", "evidence": ["u10"], "flag": null}, "dose": {"value": "1 tablet", "evidence": ["u10"], "flag": null}, "frequency": {"value": "At night", "evidence": ["u10"], "flag": null}, "duration": {"value": "5 days", "evidence": ["u10"], "flag": null}}], "advice": [{"value": "Avoid prawns and other shellfish", "evidence": ["u13"], "flag": null}, {"value": "Do not drive after taking hydroxyzine, it can cause sleepiness", "evidence": ["u13"], "flag": null}], "follow_up": {"value": "Go to emergency immediately if lip swelling or breathing trouble", "evidence": ["u14"], "flag": null}}}
{"case_id": "dev-008", "split": "dev", "review_status": "draft", "tags": ["allergy", "patient-reported-allergy", "chest-infection"], "transcript": [{"id": "u01", "speaker": "doctor", "text": "Good morning. Name and age please."}, {"id": "u02", "speaker": "patient", "text": "Arjun Reddy, 30."}, {"id": "u03", "speaker": "patient", "text": "I have a cough with yellow phlegm and fever for five days."}, {"id": "u04", "speaker": "doctor", "text": "Any breathlessness or chest pain?"}, {"id": "u05", "speaker": "patient", "text": "A little breathless when climbing stairs."}, {"id": "u06", "speaker": "doctor", "text": "Are you allergic to any medicine?"}, {"id": "u07", "speaker": "patient", "text": "Yes, penicillin. I got a rash all over my body when I took amoxicillin two years ago."}, {"id": "u08", "speaker": "doctor", "text": "Okay, I will note that. Temperature is 101.2 F. There are crackles at the right lower chest. Oxygen saturation is 97 percent."}, {"id": "u09", "speaker": "doctor", "text": "This looks like a chest infection, possibly early pneumonia on the right side."}, {"id": "u10", "speaker": "doctor", "text": "Since you are allergic to penicillin, I will give you azithromycin 500 mg, one tablet once a day for three days."}, {"id": "u11", "speaker": "doctor", "text": "Paracetamol 650 mg, one tablet three times a day for three days."}, {"id": "u12", "speaker": "doctor", "text": "Get a chest X-ray and a complete blood count done today."}, {"id": "u13", "speaker": "doctor", "text": "Rest and drink plenty of fluids. Come back after three days with the X-ray, or earlier if your breathing gets worse."}], "expected_prescription": {"patient_details": {"name": {"value": "Arjun Reddy", "evidence": ["u02"], "flag": null}, "age": {"value": 30, "evidence": ["u02"], "flag": null}}, "chief_complaints": [{"value": "Cough with yellow phlegm", "evidence": ["u03"], "flag": null}, {"value": "Fever", "evidence": ["u03"], "flag": null}], "history_of_present_illness": {"value": "Cough w