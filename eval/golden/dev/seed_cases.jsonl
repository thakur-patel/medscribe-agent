{"case_id": "dev-006", "split": "dev", "review_status": "draft", "tags": ["missing-dose", "missing-strength", "back-pain"], "transcript": [{"id": "u01", "speaker": "doctor", "text": "Good afternoon. Your name and age?"}, {"id": "u02", "speaker": "patient", "text": "Kavita Joshi, 41."}, {"id": "u03", "speaker": "patient", "text": "I have lower back pain since yesterday, after lifting a heavy bucket."}, {"id": "u04", "speaker": "doctor", "text": "Does the pain go down your leg? Any numbness?"}, {"id": "u05", "speaker": "patient", "text": "No, it stays in the lower back. No numbness."}, {"id": "u06", "speaker": "doctor", "text": "Any stomach ulcer or acidity problems?"}, {"id": "u07", "speaker": "patient", "text": "Sometimes acidity."}, {"id": "u08", "speaker": "doctor", "text": "There is tenderness and muscle spasm in the lower back on the right side. Straight leg raise is normal."}, {"id": "u09", "speaker": "doctor", "text": "This is a muscle strain of the lower back."}, {"id": "u10", "speaker": "doctor", "text": "Take ibuprofen after food, twice a day, for three days."}, {"id": "u11", "speaker": "doctor", "text": "Along with it, pantoprazole 40 mg once a day before breakfast for three days, to protect your stomach."}, {"id": "u12", "speaker": "doctor", "text": "Apply a hot water bag, and avoid lifting heavy things for two weeks."}, {"id": "u13", "speaker": "doctor", "text": "If the pain spreads to the leg or you get numbness, come back."}], "expected_prescription": {"patient_details": {"name": {"value": "Kavita Joshi", "evidence": ["u02"], "flag": null}, "age": {"value": 41, "evidence": ["u02"], "flag": null}}, "chief_complaints": [{"value": "Lower back pain", "evidence": ["u03"], "flag": null}], "history_of_present_illness": {"value": "Lower back pain since yesterday after lifting a heavy bucket, not radiating to the leg, no numbness", "evidence": ["u03", "u05"], "flag": null}, "duration": {"value": "1 day", "evidence": ["u03"], "flag": null}, "past_medical_history