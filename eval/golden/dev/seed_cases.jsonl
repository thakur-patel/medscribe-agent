{"case_id": "dev-002", "split": "dev", "review_status": "draft", "tags": ["routine", "hypertension"], "transcript": [{"id": "u01", "speaker": "doctor", "text": "Hello. From the registration slip, Suresh Patil, 56 years, male. You are here about your blood pressure?"}, {"id": "u02", "speaker": "patient", "text": "Yes doctor. I was told a month ago that my BP was high. I have been checking at home, it is around 150."}, {"id": "u03", "speaker": "doctor", "text": "Any headache, chest pain or breathlessness?"}, {"id": "u04", "speaker": "patient", "text": "Occasional headache in the morning. No chest pain."}, {"id": "u05", "speaker": "doctor", "text": "Do you have diabetes or any other illness? Are you taking any medicines?"}, {"id": "u06", "speaker": "patient", "text": "No diabetes. I am not taking any medicines."}, {"id": "u07", "speaker": "doctor", "text": "Your BP today is 152 over 96. Heart sounds are normal."}, {"id": "u08", "speaker": "doctor", "text": "This is hypertension. We will start treatment."}, {"id": "u09", "speaker": "doctor", "text": "Start amlodipine 5 mg, one tablet once daily in the morning, for one month."}, {"id": "u10", "speaker": "doctor", "text": "Reduce salt in your food, walk for thirty minutes daily, and keep checking your BP at home."}, {"id": "u11", "speaker": "doctor", "text": "Get a kidney function test and a lipid profile done before the next visit."}, {"id": "u12", "speaker": "doctor", "text": "Come back after one month with the reports."}], "expected_prescription": {"patient_details": {"name": {"value": "Suresh Patil", "evidence": ["u01"], "flag": null}, "age": {"value": 56, "evidence": ["u01"], "flag": null}, "gender": {"value": "Male", "evidence": ["u01"], "flag": null}}, "chief_complaints": [{"value": "High blood pressure", "evidence": ["u01", "u02"], "flag": null}], "history_of_present_illness": {"value": "Told a month ago that BP was high, home readings around 150, occasional morning headache, no chest pain", "evidence": ["u02", "u